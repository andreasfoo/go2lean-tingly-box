+// closeThinkingBlock signs and stops the thinking block at *index if it is
+// still open, and clears *index.
+func (r *responsesToAnthropicConverter) closeThinkingBlock(index *int) {
+	if *index != -1 && !r.state.stoppedBlocks[*index] {
+		r.emitThinkingSignature(*index)
+		r.emitContentBlockStop(*index)
+	}
+	*index = -1
+}
