+// completeToolCall sends the arguments of a tool call no delta streamed
+// and stops its block, once.
+func (r *responsesToAnthropicConverter) completeToolCall(tc *responsesToAnthropicToolCall, arguments string) {
+	if tc.completed {
+		return
+	}
+	if !tc.hasInput && arguments != "" {
+		r.emitContentBlockDelta(tc.blockIndex, anthropicInputJSONDelta(arguments))
+		tc.hasInput = true
+	}
+	r.emitContentBlockStop(tc.blockIndex)
+	tc.completed = true
