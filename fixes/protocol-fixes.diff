+// newChatToolCallIndex assigns the next Chat tool_calls index to a Responses
+// function call item that starts. Chat indexes number the tool calls of the
+// choice 0, 1, ... in the order they start; the Responses output_index also
+// counts reasoning and message items, so it cannot be used as is.
+func (c *responsesToChatConverter) newChatToolCallIndex(itemID string, outputIndex int64) int {
+	index := c.toolCallCount
+	c.toolCallCount++
+	if itemID != "" {
+		c.toolCallIndexes[itemID] = index
+	}
+	c.toolCallOutputs[outputIndex] = index
+	return index
+}
+
+// chatToolCallIndex returns the Chat tool_calls index of the function call
+// item an event refers to, by item id or else by output_index; an item not
+// seen before gets the next index.
+func (c *responsesToChatConverter) chatToolCallIndex(itemID string, outputIndex int64) int {
+	if itemID != "" {
+		if index, ok := c.toolCallIndexes[itemID]; ok {
+			return index
+		}
+	} else if index, ok := c.toolCallOutputs[outputIndex]; ok {
+		return index
+	}
+	return c.newChatToolCallIndex(itemID, outputIndex)
+}
